    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.3
  m_Text: "H\u1ED2 S\u01A0 GIA CH\u1EE6 & T\u1EE6 \u0110\u1ED2 PH\u1ED0 NH\u1ECE:\r\n------------------------------------------------------------\r\n\u2022
    Ch\u1EE7 nh\xE0: C\u01B0 D\xE2n Ph\u1ED1 Nh\u1ECF\r\n\u2022 V\u1ED1n Scoin: 243
    Scoin\r\n\u2022 \u0110\xE1 qu\xFD Gem: 10 Gem\r\n\u2022 \u0110i\u1EC3m B\xE1
    Kh\xED: 100 \u0111i\u1EC3m (Trang ph\u1EE5c Chibi c\u01A1 b\u1EA3n)\r\n\r\nKHO
    NGUY\xCAN LI\u1EC6U:\r\n  (Ch\u01B0a c\xF3 nguy\xEAn li\u1EC7u n\xE0o. H\xE3y
    gh\xE9 Ch\u1EE3 Nguy\xEAn Li\u1EC7u \u0111\u1EC3 mua s\u1EC9!)\r\n\r\nM\xD3N
    \u0110\xC3 CH\u1EBE BI\u1EBEN HO\xC0N T\u1EA4T:\r\n  - Tr\xE0 S\u1EEFa Truy\u1EC1n
    Th\u1ED1ng: 1 ph\u1EA7n\r\n  - Tr\xE0 S\u1EEFa Tr\xE2n Ch\xE2u \u0110\u01B0\u1EDDng
    \u0110en: 1 ph\u1EA7n\r\n"
